{
  "manifestVersion": 5,
  "id": "com.pocketmonitor.photoshop",
  "name": "Pocket Monitor",
  "version": "0.3.3",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "openTetheryPanel",
      "label": {
        "default": "Pocket Monitor"
      },
      "minimumSize": {
        "width": 250,
        "height": 360
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 680
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 680
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [1, 2],
          "theme": ["all"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ]
}

<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.screenlive.video" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Live Video Preview">
    <ExtensionList>
        <Extension Id="com.screenlive.video.panel" Version="1.0.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Adobe Premiere Pro 2020-2026+ -->
            <Host Name="PPRO" Version="[14.0,99.9]"/>
            <!-- Adobe After Effects 2020-2026+ -->
            <Host Name="AEFT" Version="[17.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.screenlive.video.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Live Video Preview</Menu>
                    <Geometry>
                        <Size>
                            <Width>300</Width>
                            <Height>580</Height>
                        </Size>
                        <MinSize>
                            <Width>240</Width>
                            <Height>380</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>600</Width>
                            <Height>1200</Height>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
